module MerkleMachines
  VERSION: String
  PENDING_CAPACITY: Integer
  OUTPUT_CAPACITY: Integer
  MAX_FANOUT: Integer

  # The core's `Mismatch`: the first field on which two schemas disagree.
  type mismatch = :fanout_mismatch | :depth_mismatch | :partitioning_mismatch | :digest_mismatch

  # Refusals are symbols, one per core reason, and a refused call changes
  # nothing. `Refusal::Schema(Mismatch)` is the mismatch's own symbol.
  type begin_refusal = mismatch | :undersized | :busy | :exhausted
  type answer_refusal = :stale | :unexpected | :version_changed | :arity | :inconsistent
  type requeue_refusal = :stale | :unexpected
  type refusal = begin_refusal | answer_refusal | requeue_refusal

  # Mirrors the core's `Schema`. Like `Schema::new`, `new` has no value for a
  # `fanout` outside 2..MAX_FANOUT or a tree with more leaves than fit in 64
  # bits: it raises RangeError (TypeError for a non-Integer).
  class Schema < Data
    attr_reader fanout: Integer
    attr_reader depth: Integer
    attr_reader partitioning: Integer
    attr_reader digest: Integer
    def self.new: (Integer fanout, Integer depth, Integer partitioning, Integer digest) -> Schema
                | (fanout: Integer, depth: Integer, partitioning: Integer, digest: Integer) -> Schema
    # Total number of leaves.
    def leaves: () -> Integer
    # Nodes at `level` (0..255), saturating past the leaf level.
    def width: (Integer level) -> Integer
    # Leaves below `node`, the core's `LeafRange` as a half-open Range; nil
    # when the node is not part of the tree.
    def span: (Node node) -> Range[Integer]?
    # :compatible, or the first field on which `other` differs.
    def compatible: (Schema other) -> (:compatible | mismatch)
  end

  # Mirrors the core's `Versions`: Integers in 0..2**64-1. `new` raises
  # TypeError for a non-Integer and RangeError outside the range.
  class Versions < Data
    attr_reader local: Integer
    attr_reader remote: Integer
    def self.new: (Integer local, Integer remote) -> Versions
                | (local: Integer, remote: Integer) -> Versions
  end

  # Mirrors the core's `Node`: `level` in 0..255, `index` in 0..2**64-1.
  # `new` raises TypeError for a non-Integer and RangeError outside the range.
  class Node < Data
    ROOT: Node

    attr_reader level: Integer
    attr_reader index: Integer
    def self.new: (Integer level, Integer index) -> Node
                | (level: Integer, index: Integer) -> Node
  end

  # Mirrors the core's `Request`. `session` is a scoped id: the issuing
  # survey's scope in the top 16 bits, its session count (from one) below.
  # Like `Request::new`, `new` has no value for a session of sequence number
  # zero, which no survey issues: RangeError, as for a session outside
  # 0..2**64-1; TypeError for a non-Integer session or a node that is not a
  # Node.
  class Request < Data
    attr_reader session: Integer
    attr_reader node: Node
    def self.new: (Integer session, Node node) -> Request
                | (session: Integer, node: Node) -> Request
    # The scope of the survey that issued the session, 0..65535.
    def scope: () -> Integer
  end

  class Survey
    # Scope zero.
    def self.new: () -> Survey
    # `scope` is an Integer in 0..65535: TypeError otherwise, RangeError
    # outside the range.
    def self.with_scope: (Integer scope) -> Survey
    # Continues `scope` after a restart from a saved `issued` count. Restores
    # only the session sequence: the survey is idle. RangeError when `issued`
    # is above 2**48 - 1.
    def self.resumed: (Integer scope, Integer issued) -> Survey
    # The scope carried by every session, and so every Request, of this survey.
    def scope: () -> Integer
    # Sessions issued in this scope so far: the count to save for `resumed`.
    def issued: () -> Integer
    # Honoured: :identical, :diverged. Refused: begin_refusal.
    def begin: (Schema local, Schema remote, Versions versions, String local_root, String remote_root) -> (:identical | :diverged | begin_refusal)
    # The next node whose child digests are wanted, nil when nothing is queued.
    # Never refuses.
    def next_request: () -> Request?
    # Honoured: :accepted. Refused: answer_refusal; :stale covers a Request
    # from an earlier session or from a survey in another scope.
    def answer: (Request request, Versions versions, Array[String] local, Array[String] remote) -> (:accepted | answer_refusal)
    # Honoured: :requeued. Refused: requeue_refusal.
    def requeue: (Request request) -> (:requeued | requeue_refusal)
    # How many in-flight requests went back to the queue. Never refuses.
    def requeue_all: () -> Integer
    # The lowest buffered leaf range, nil when none is buffered. Never refuses.
    def pop_range: () -> Range[Integer]?
    # At most `limit` buffered leaf ranges, lowest first, [] when none is
    # buffered. A limit above OUTPUT_CAPACITY takes them all. Never refuses.
    def drain: (Integer limit) -> Array[Range[Integer]]
    # Honoured: :aborted when a session was dropped, and the repeat
    # :already_idle when none was open (nothing changes). Never refuses.
    def abort: () -> (:aborted | :already_idle)
    def phase: () -> (:idle | :surveying | :draining | :complete)
    # The id of the latest session issued in this scope, open or not; nil
    # while none was ever begun. After `abort` it is the aborted session; a
    # resumed survey, idle until its next `begin`, answers the last session
    # issued before the restart (nil when resumed from a count of zero).
    def session: () -> Integer?
    # The schema of the open session, nil when the survey is idle.
    def schema: () -> Schema?
    # The versions the open session pinned, nil when the survey is idle.
    def versions: () -> Versions?
    def pending: () -> Integer
    def in_flight: () -> Integer
    def buffered: () -> Integer
  end
end
